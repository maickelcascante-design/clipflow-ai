{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "clipflow-ai",
  "main": "./worker.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TEXT_MODEL": "gpt-5.6"
  },
  "observability": {
    "enabled": true
  }
}